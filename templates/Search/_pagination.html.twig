{% set paginationLimits = requestConfiguration.availableLimits %}

<div class="dropdown sylius-paginate">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            {{ 'sylius.ui.show'|trans }} {{ result.paginator.maxPerPage }}
        </button>
            <div class="dropdown-menu">
                {% for limit in paginationLimits|filter(limit => limit != result.paginator.maxPerPage) %}
                    {% set path = path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({'limit': limit, 'page': 1})) %}
                    <a class="dropdown-item" href="{{ path }}">{{ limit }}</a>
                {% endfor %}
            </div>
</div>
