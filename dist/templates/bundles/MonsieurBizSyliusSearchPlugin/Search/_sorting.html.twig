{% extends '@!MonsieurBizSyliusSearchPlugin/Search/_sorting.html.twig' %}

{% block sorting_label %}
    {% if sorting.short_description is defined %}
        {{ (sorting.short_description == 'asc' ? 'app.ui.short_desc_a_to_z_path' : 'app.ui.short_desc_z_to_a_path')|trans }}
    {% else %}{{ parent() }}{% endif %}
{% endblock %}

{% block sorting_choices %}
    {{ parent() }}
    <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'short_description': 'asc'}})) }}">{{ 'app.ui.short_desc_a_to_z_path'|trans }}</a>
    <a class="dropdown-item" href="{{ path(route, route_parameters|merge({'sorting': {'short_description': 'desc'}})) }}">{{ 'app.ui.short_desc_z_to_a_path'|trans }}</a>
{% endblock %}
