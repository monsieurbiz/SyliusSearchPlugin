services:
    database:
        image: mysql:8.0
        command: --default-authentication-plugin=mysql_native_password
        ports:
            - "127.0.0.1:3306:3306"
        environment:
          MYSQL_ALLOW_EMPTY_PASSWORD: 1
          MYSQL_DATABASE: sylius
        volumes:
            - database:/var/lib/mysql
        healthcheck:
            test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
            interval: 5s
            timeout: 5s
            retries: 30

    mailer:
        image: monsieurbiz/mailcatcher
        ports:
            - "127.0.0.1::1025"
            - "127.0.0.1::1080"

volumes:
    database: {}
