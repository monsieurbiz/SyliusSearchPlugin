parameters:
    level: max
    paths:
        - src/

    excludePaths:
        # Makes PHPStan crash
        - 'src/DependencyInjection/Configuration.php'
        - 'src/DependencyInjection/MonsieurBizSyliusSearchExtension.php'

        # Test dependencies
        - 'tests/Application/**/*'

        # Generated files
        - 'generated/**/*'

    ignoreErrors:
        - identifier: missingType.generics
        - identifier: missingType.iterableValue
